NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=racha_se
DATABASE_URL=postgres://postgres:postgres@localhost:6969/racha_se

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# origin the frontend calls this API from — used for both CORS (browser)
# and better-auth's trustedOrigins (server-side, see src/utils/auth.ts).
# No frontend exists yet, this is just a placeholder — change it once one does.
CORS_ORIGIN=http://localhost:3001

# only needed for `bun run create-admin` (see README) — pass inline at
# invocation time instead of filling these in here, so a real admin
# password never ends up sitting in a persisted .env file
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRSTNAME=
ADMIN_LASTNAME=
ADMIN_USERNAME=

# SMTP — used by better-auth's forgot/reset-password email (src/utils/mailer.ts).
# Local dev: docker compose up -d mailpit, no auth needed — it catches every
# email instead of sending it for real; view them at http://localhost:6826.
# Point these at a real provider (SendGrid, SES, ...) outside local dev.
SMTP_HOST=localhost
SMTP_PORT=6825
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Racha SE <no-reply@racha-se.local>"
