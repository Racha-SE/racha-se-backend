{
  "name": "racha-se-backend",
  "version": "1.0.50",
  "description": "Backend Repo of Racha SE - 2110423 Software Engineering Project",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:mock-users": "docker compose exec -T db psql -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-racha_se} < seeds/mock_users.sql",
    "create-admin": "bun run scripts/create-admin.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "drizzle-typebox": "^0.3.3",
    "elysia": "latest"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "typescript": "^5.7",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "@sinclair/typebox": "0.32.4"
  }
}
